print("Digite o valor de um produto e quantos % de promocao esta para saber o valor final");
input(valorDoProduto);
input(porcentagemDesconto);
if(porcentagemDesconto > 100) {
    while(porcentagemDesconto > 100) {
        print("Promocoes acima de 100% nao existem seu bobo, tente de novo");
        input(porcentagemDesconto);
    }
}
print("O valor final do produto eh " + (valorDoProduto - valorDoProduto*porcentagemDesconto/100));